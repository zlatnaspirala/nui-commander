{
  "name": "nui-commander",
  "short-name": "nui-commander",
  "version": "1.2.0",
  "description": "Give command with hands low cpu usage based on block detect webcam samples. Top performance js code .AI driven solutions from 2026",
  "main": "index.js",
  "scripts": {
    "build.lib": "esbuild index.js --bundle --platform=browser --format=iife --global-name=NuiCommander --outfile=build/nui-commander.js",
    "test": "esbuild main.js --bundle --platform=browser --format=iife --global-name=NuiCommanderTest --outfile=build/test.js",
    "start": "http-server ./public/ -p 3000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zlatnaspirala/voice-commander.git"
  },
  "keywords": [
    "low-cpu-usage",
    "Natural-User-Interface",
    "NUI",
    "control-hand",
    "slider",
    "nui-button",
    "nui-games",
    "no-cost",
    "low-cpu",
    "nui-detect",
    "js",
    "vanillaJS",
    "nui-commander",
    "commander",
    "javascript",
    "ECMA6"
  ],
  "author": "Nikola Lukic zlatnaspirala@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zlatnaspirala/voice-commander/issues"
  },
  "homepage": "https://github.com/zlatnaspirala/voice-commander#readme",
  "dependencies": {
    "http-server": "^14.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
